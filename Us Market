          EOF
          mkdir -p app/src/main/res/layout
          cat > app/src/main/res/layout/widget.xml <<'EOF'
          <?xml version="1.0" encoding="utf-8"?>
          <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent" android:layout_height="match_parent"
              android:orientation="vertical" android:padding="14dp"
              android:background="@drawable/bg">

              <TextView android:id="@+id/st" android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:text="US Market" android:textSize="17sp" android:textStyle="bold" android:textColor="#17B890" />
              <Chronometer android:id="@+id/cd" android:layout_width="wrap_content" android:layout_height="wrap_content"
                  android:textSize="34sp" android:textStyle="bold" android:textColor="#E8EDF5" />
              <TextView android:id="@+id/nx" android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:textSize="11sp" android:textColor="#9AA7BA" />

              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:orientation="horizontal" android:layout_marginTop="8dp" android:layout_marginBottom="6dp">
                  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                      android:text="ไทย" android:textSize="11sp" android:textColor="#9AA7BA" />
                  <TextClock android:id="@+id/thc" android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:timeZone="Asia/Bangkok" android:format24Hour="HH:mm:ss" android:format12Hour="HH:mm:ss"
                      android:textSize="14sp" android:textColor="#E8EDF5" />
                  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                      android:gravity="end" android:text="นิวยอร์ก" android:textSize="11sp" android:textColor="#9AA7BA" />
                  <TextClock android:id="@+id/nyc" android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:layout_marginStart="6dp"
                      android:timeZone="America/New_York" android:format24Hour="HH:mm:ss" android:format12Hour="HH:mm:ss"
                      android:textSize="14sp" android:textColor="#E8EDF5" />
              </LinearLayout>

              <TextView android:id="@+id/dt" android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:textSize="11sp" android:textColor="#9AA7BA" />
              <TextView android:id="@+id/r1" android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:padding="5dp" android:textSize="12sp" android:textColor="#E8EDF5" />
              <TextView android:id="@+id/r2" android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:padding="5dp" android:textSize="12sp" android:textColor="#E8EDF5" />
              <TextView android:id="@+id/r3" android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:padding="5dp" android:textSize="12sp" android:textColor="#E8EDF5" />
              <TextView android:id="@+id/hl" android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:layout_marginTop="4dp" android:textSize="11sp" android:textColor="#9AA7BA" />
          </LinearLayout>
          EOF
          mkdir -p app/src/main/res/values
          cat > app/src/main/res/values/strings.xml <<'EOF'
          <resources>
              <string name="app_name">US Market</string>
              <string name="widget_desc">เวลาตลาดหุ้นสหรัฐ นับถอยหลังและตารางช่วงซื้อขาย</string>
          </resources>
          EOF
          mkdir -p app/src/main/res/xml
          cat > app/src/main/res/xml/widget_info.xml <<'EOF'
          <?xml version="1.0" encoding="utf-8"?>
          <appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
              android:minWidth="250dp" android:minHeight="190dp"
              android:targetCellWidth="4" android:targetCellHeight="3"
              android:updatePeriodMillis="1800000"
              android:resizeMode="horizontal|vertical"
              android:widgetCategory="home_screen"
              android:description="@string/widget_desc"
              android:initialLayout="@layout/widget"
              android:previewLayout="@layout/widget" />
          EOF
          cat > build.gradle.kts <<'EOF'
          plugins {
              id("com.android.application") version "8.5.2" apply false
              id("org.jetbrains.kotlin.android") version "1.9.24" apply false
          }
          EOF
          cat > gradle.properties <<'EOF'
          android.useAndroidX=true
          org.gradle.jvmargs=-Xmx2g
          EOF
          cat > settings.gradle.kts <<'EOF'
          pluginManagement { repositories { google(); mavenCentral(); gradlePluginPortal() } }
          dependencyResolutionManagement { repositories { google(); mavenCentral() } }
          rootProject.name = "USMarketWidget"
          include(":app")
          EOF
      - run: cd USMarketWidget && gradle assembleDebug --no-daemon
      - uses: actions/upload-artifact@v4
        with:
          name: us-market-apk
          path: USMarketWidget/app/build/outputs/apk/debug/app-debug.apk
